[Unit]
Description=Libro digital de Ciencia de Datos e IA
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/datos/curso_ds_ia_uap
ExecStart=%h/datos/curso_ds_ia_uap/.venv/bin/waitress-serve --listen=0.0.0.0:7000 app:app
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
