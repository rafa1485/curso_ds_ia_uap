[Unit]
Description=Libro digital de Ciencia de Datos e IA local Rafa
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/rafa/CLASES_DS_IA_UAP
ExecStart=/home/rafa/CLASES_DS_IA_UAP/.venv/bin/waitress-serve --listen=127.0.0.1:7000 app:app
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
